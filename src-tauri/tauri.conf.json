{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pico",
  "version": "0.1.0",
  "identifier": "dev.picompiler.pico",
  "build": {
    "frontendDist": "https://picompiler.pages.dev"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pico",
        "width": 1200,
        "height": 820,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "backgroundColor": "#1e1e2e"
      }
    ],
    "security": {
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Pico programming and computer science learning",
    "category": "Education",
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
