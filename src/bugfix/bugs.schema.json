{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pico Bug Fix Lab catalog",
  "type": "object",
  "required": [
    "challenges"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "challenges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "topic",
          "brief",
          "starter",
          "solution",
          "explanation",
          "difficulty",
          "hints",
          "tests"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "not": {
              "enum": [
                "constructor",
                "prototype"
              ]
            }
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "topic": {
            "type": "string",
            "minLength": 1
          },
          "brief": {
            "type": "string",
            "minLength": 1
          },
          "starter": {
            "type": "string",
            "minLength": 1
          },
          "solution": {
            "type": "string",
            "minLength": 1
          },
          "explanation": {
            "type": "string",
            "minLength": 1
          },
          "difficulty": {
            "enum": [
              "Easy",
              "Medium",
              "Hard"
            ]
          },
          "hints": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tests": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "name",
                "inputs",
                "expected"
              ],
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "inputs": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "expected": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
